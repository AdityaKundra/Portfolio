# AI answers are off by default, and Ask searches the site instead.
# To turn them on, set both of these and rebuild.
VITE_ASK_AI=
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5.
ASK_MODEL=

# Optional. Total tokens per UTC day before Ask pauses. Defaults to 300000.
ASK_DAILY_TOKEN_BUDGET=

# Recommended in production. Without these, rate limits and the budget are per serverless instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
